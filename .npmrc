# Every dependency in this repo is pinned to one exact version, so a fresh install
# and a CI install resolve to the same bytes. save-exact keeps a later `pnpm add`
# from putting a caret back in.
save-exact=true

# engines.node and engines.pnpm in package.json are exact. Fail rather than warn if
# the machine is on a different one: CI reads the same versions from .nvmrc and the
# packageManager field, so a mismatch here means the local machine has drifted.
engine-strict=true
