+        solver.solve(&probe_config(1, 2), |_| {}).unwrap();
+        println!("attempt identity before={first}, after={}", solver.job());
+        assert!(
+            solver.accept(first, report).is_err(),
+            "previous solve completion was accepted after the next attempt"
