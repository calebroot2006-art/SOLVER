# Matches .gitattributes (LF in the repository) and the two formatters that police
# this repo: rustfmt for Rust, prettier for everything under app/.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.rs]
indent_size = 4
max_line_length = 100

[*.{toml,lock}]
indent_size = 4

[*.md]
# Two trailing spaces are a Markdown line break, so leave them alone.
trim_trailing_whitespace = false

[*.{bat,cmd,ps1}]
end_of_line = crlf

[Makefile]
indent_style = tab
